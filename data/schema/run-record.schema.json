{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefractRouter Run Record",
  "type": "object",
  "required": ["task_id", "strategy", "task_result"],
  "properties": {
    "task_id": {"type": "string"},
    "strategy": {"type": "string"},
    "task_result": {
      "type": "object",
      "required": ["task_id", "strategy", "model_assignments", "node_results", "final_output", "task_score", "total_cost_usd", "critical_path_latency_ms"],
      "properties": {
        "task_id": {"type": "string"},
        "strategy": {"type": "string"},
        "model_assignments": {"type": "object", "additionalProperties": {"type": "string"}},
        "node_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "node_type", "model_id", "output", "input_tokens", "output_tokens", "cost_usd", "latency_ms", "score", "status"],
            "properties": {
              "node_id": {"type": "string"},
              "node_type": {"type": "string"},
              "model_id": {"type": "string"},
              "output": {"type": "string"},
              "input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0},
              "cost_usd": {"type": "number", "minimum": 0},
              "latency_ms": {"type": "integer", "minimum": 0},
              "score": {"type": "number", "minimum": 0, "maximum": 100},
              "status": {"type": "string"},
              "failure_type": {"type": ["string", "null"]},
              "cached_input_tokens": {"type": "integer", "minimum": 0},
              "reasoning_tokens": {"type": "integer", "minimum": 0},
              "attempts": {"type": "integer", "minimum": 0},
              "finish_reason": {"type": ["string", "null"]},
              "request_id": {"type": ["string", "null"]},
              "error_message": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "final_output": {"type": "string"},
        "task_score": {"type": "number", "minimum": 0, "maximum": 100},
        "total_cost_usd": {"type": "number", "minimum": 0},
        "critical_path_latency_ms": {"type": "integer", "minimum": 0},
        "failure_types": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
