{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefractRouter Benchmark Dataset",
  "type": "object",
  "required": [
    "schema_version",
    "train_task_ids",
    "test_task_ids",
    "pilot_task_ids",
    "human_audit_task_ids"
  ],
  "properties": {
    "schema_version": {"const": "v0.1"},
    "description": {"type": "string"},
    "train_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    },
    "test_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    },
    "pilot_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    },
    "human_audit_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    }
  },
  "additionalProperties": false
}
