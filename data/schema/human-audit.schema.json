{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefractRouter Human Audit",
  "type": "object",
  "required": [
    "schema_version",
    "rubric_version",
    "agreement_threshold_points",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "v0.1"},
    "rubric_version": {"type": "string"},
    "agreement_threshold_points": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "strategy", "human_score", "reviewer", "notes"],
        "properties": {
          "task_id": {"type": "string"},
          "strategy": {"enum": ["task-oracle", "node-oracle"]},
          "human_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "reviewer": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
