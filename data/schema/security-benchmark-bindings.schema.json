{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AEALab/RefractRouter/data/schema/security-benchmark-bindings.schema.json",
  "title": "安全约束基准真实模型绑定",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue", "protocol_sha256", "frozen_at", "pricing_snapshot_date", "billing_unit", "sources", "endpointPolicies", "bindings"],
  "properties": {
    "schema_version": {"const": "security-benchmark-bindings-v1"},
    "issue": {"const": 112},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_at": {"type": "string"},
    "pricing_snapshot_date": {"type": "string"},
    "billing_unit": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1},
    "endpointPolicies": {"type": "array"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleId", "status", "blockers", "binding"],
        "properties": {
          "roleId": {"type": "string", "minLength": 1},
          "status": {"enum": ["bound", "blocked"]},
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "binding": {"type": ["object", "null"]}
        }
      }
    }
  }
}
