{
  "schemaVersion": "refractagent-providers-v3",
  "billingUnit": "USD",
  "qualityMin": 80,
  "security": {
    "dataMode": "live",
    "sensitiveTerms": ["内部项目代号"],
    "maxPromptBytes": 1048576
  },
  "trustPolicies": [
    {
      "id": "team-cn-audited",
      "residency": "CN",
      "auditLogging": true,
      "allowsSensitiveData": true
    }
