      "deployment": "external-cloud"
    },
    {
      "id": "team-cloud",
      "type": "openai-compatible",
      "baseUrl": "https://trusted.example/v1",
      "credentialEnv": "TEAM_CLOUD_KEY",
      "deployment": "trusted-cloud",
      "trustPolicy": "team-cn-audited"
    },
    {
      "id": "local-runtime",
      "type": "openai-compatible",
      "baseUrl": "http://127.0.0.1:8000/v1",
      "deployment": "local"
    }
  ],
