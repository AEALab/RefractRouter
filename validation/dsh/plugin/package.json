{
  "name": "dsh-refractrouter-validation",
  "version": "0.12.0",
  "description": "DeepSeek Harness bundle for structured RefractRouter benchmark validation",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AEALab/RefractRouter.git",
    "directory": "validation/dsh/plugin"
  },
  "bugs": {
    "url": "https://github.com/AEALab/RefractRouter/issues"
  },
  "homepage": "https://github.com/AEALab/RefractRouter/tree/main/validation/dsh/plugin",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "llm-routing",
    "validation"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./agent": {
      "types": "./dist/agent-provider.d.ts",
      "import": "./dist/agent-provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "pnpm@10.15.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "cli": "0.1.1-rc.2",
      "node": ">=22.19.0 <23"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && npm run test:contracts",
    "prepack": "npm run build",
    "test:contracts": "tsc -p tsconfig.test.json && node --test .test-dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
