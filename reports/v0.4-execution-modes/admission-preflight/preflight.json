        "source_documents": [
          {
            "source_id": "source_001",
            "title": "DeepAgents",
            "content": "DeepAgents is a LangChain harness built on LangGraph. It provides planning, sub-agents, a filesystem abstraction, and human-in-the-loop controls. For RefractRouter v0.1, DeepAgents is useful as the fixed-DAG execution harness, but its autonomous planning and dynamic sub-agent generation should remain disabled.",
            "content_hash": "ed7d5a479cc077720b641eb8ecf4a25c3af32701fc8403138c57532c6dd03d39"
          },
          {
            "source_id": "source_002",
            "title": "LangGraph",
            "content": "LangGraph is a graph state machine framework for complex workflows. It supports explicit nodes, edges, durable state, and check-pointing. RefractRouter uses LangGraph as the lower-level execution substrate for a fixed task DAG.",
            "content_hash": "97960ed618df652ae16f900a1ea677e257684118f5eab68686b2f8713ae74960"
          },
          {
            "source_id": "source_003",
            "title": "Pydantic AI",
            "content": "Pydantic AI provides typed tool definitions and structured model outputs. It is useful when strict schemas are required, but RefractRouter v0.1 does not need it as a core dependency unless structured-output parsing becomes a bottleneck.",
            "content_hash": "7edd7c4a831f8cb06e0c9fc8b17911818ad63ff686b7d7245b176c46a3cea42e"
          },
          {
            "source_id": "source_004",
            "title": "DeepSeek Harness",
            "content": "DeepSeek Harness, or DSH, is an agent harness where the agent loop itself is a plugin. For RefractRouter v0.1, DSH is reserved for the outer validation environment, not the core routing loop.",
            "content_hash": "b06d562fa3e636b8ffb02c1578e300033ae7f23672b90445a9489bbe65b57331"
          },
          {
            "source_id": "source_005",
            "title": "LLM routing research gap",
            "content": "Existing LLM routing work mostly selects one model for an entire request. RefractRouter studies whether selecting a model separately for each node in a task DAG can improve the quality-cost-latency Pareto frontier.",
            "content_hash": "418b6cda722a8338f10fa145fb4f4f5c3f188ff413651e4d73aa2949b4e07460"
          },
          {
            "source_id": "source_006",
            "title": "Task decomposition boundary",
            "content": "Static task decomposition belongs to the application layer. The router receives the DAG as input and focuses on per-node model selection. Dynamic re-splitting is deferred until node-level routing is validated.",
            "content_hash": "96a837f9788f5d0c6d9ab2cc9633775c42dc5569afc70b1782dc1d6d7a198504"
          },
          {
            "source_id": "source_007",
            "title": "Benchmark design",
            "content": "A useful routing benchmark needs fixed task DAGs, multiple candidate models, per-node and per-task scoring, cost accounting, and critical-path latency. The first benchmark should stay small enough to reproduce.",
            "content_hash": "03e9443028f0065ae41218c422efdcebe73225465468098c9ba49f03596be4d0"
          },
          {
            "source_id": "source_008",
            "title": "Scoring rubric",
            "content": "The v0.1 scoring rubric weights requirement coverage, evidence accuracy, analysis depth, structure and readability, and HTML validity. Scoring prompts and rubric versions must be versioned with run records.",
            "content_hash": "b669e75265f9d0997a8f62659ca6526b2911a6d4af1f2c9ed956870c166a816e"
          }
        ],
        "output_contract_version": "v0.4",
        "execution_mode": "one-shot"
      },
