    "tasks": [
      {
        "id": "dev_sampling_after_schema_failure",
        "split": "development",
        "task": "虚构的自然观察小组要采购采样记录设备。方案甲首次采购 4200 元，每月维护 180 元；方案乙首次采购 6800 元，每月维护 60 元。使用期 12 个月，可用预算 7000 元，不计任何未提供的费用。甲需要现场人员每次出发前校准，人员是否完成培训尚未确认；乙由供应商远程协助，山地网络覆盖尚未确认。分别分析全年费用和两种维护方式的执行风险，然后给出当前预算下可执行的有条件建议。不得推断测量精度、网络可用或培训已完成。",
        "criteria": [
          "正确计算全年费用和相对预算的余额或缺口。",
          "单独讨论培训和网络的不确定性，不用费用代替风险分析。",
          "同时给出成本、风险和有条件建议，不虚构设备性能。"
        ],
        "reference": "甲 6360 元，余额 640；乙 7520 元，缺口 520。按已知费用只有甲在预算内，但须确认培训；乙须补预算并确认网络。"
      },
      {
        "id": "holdout_participant_filter",
        "split": "holdout",
        "task": "虚构的陶艺活动筛选参与者。资格要求同时满足：至少参加过两次基础课、能参加周日上午、已归还借用工具。名单：沈禾，3 次，能参加，已归还；江柯，1 次，能参加，已归还；陆晴，2 次，不能参加，已归还；顾原，4 次，能参加，未归还；唐澄，2 次，能参加，已归还；齐岚，2 次，能参加，归还情况未记录。请列出当前明确符合资格的人、明确不符合的人及原因、信息不足需确认的人。只依据名单，不推断缺失情况。",
        "criteria": [
          "准确区分明确符合、明确不符合及待确认三类人员。",
          "给出各不符合人员的具体原因，不把未记录当作已归还或未归还。",
          "不遗漏六人，也不新增信息。"
        ],
        "reference": "符合：沈禾、唐澄。不符合：江柯基础课不足，陆晴无法参加，顾原未归还。齐岚需确认工具归还情况。"
      },
      {
        "id": "holdout_document_rules",
        "split": "holdout",
        "task": "请按以下虚构资料馆规则审核四个申请，并给出可直接发送给申请人的简短说明。规则：公开目录任何人可查；扫描件仅对持有效会员证者提供，但未满 16 岁还须监护人书面同意；原件须提前两个工作日预约且仅在馆内查阅，会员资格不替代预约。申请甲：非会员，只查公开目录。乙：15 岁，会员证有效，申请扫描件，监护人同意尚未收到。丙：20 岁，会员证有效，希望今天借走原件，未预约。丁：17 岁，会员证有效，申请扫描件。不得添加收费、证件类别或其他规则。",
        "criteria": [
          "四个申请分别给出正确结论及相应规则理由。",
          "乙应待监护人书面同意；丙同时涉及未预约和不能外借，不遗漏其中之一。",
          "说明清楚友好，不添加材料未列出的限制或收费。"
        ],
        "reference": "甲可查目录；乙待监护人书面同意；丙不能今天借走，需提前两个工作日预约且馆内查阅；丁可获得扫描件。"
      },
      {
        "id": "holdout_exhibition",
        "split": "holdout",
        "task": "为一个虚构展览制定准备建议。第 0 天开始，手续 A 需要 2 天；运输 B 需要 3 天且必须等 A 完成；版面设计 C 需要 4 天，可在第 0 天独立开始；布展 D 需要 2 天，必须等 B 和 C 都完成；验收 E 需要 1 天，必须等 D 完成。各项连续执行，不考虑周末。费用为采购 1200 元、运输 800 元、布展 1500 元、设计 900 元，总预算 4600 元。分别给出最早开始和完成时间、决定总工期的依赖链、预算核算，最后说明如果 C 额外延误 2 天会怎样。没有给定的费用不得虚构。请分步骤执行：独立核对排程和费用，再综合两者给出最终安排。",
        "criteria": [
          "正确给出五项工作的最早开始和结束时间，不遗漏 B、C 汇合条件。",
          "给出总工期和关键依赖链，并正确计算 C 延误 2 天的影响。",
          "正确核算费用和预算余额，最终交付包含排程与费用。"
        ],
        "reference": "A 0–2，B 2–5，C 0–4，D 5–7，E 7–8；总工期 8 天，关键链 A-B-D-E。C 多 2 天后于第 6 天完成，D 6–8，E 8–9，总工期 9 天。费用 4400 元，余额 200 元。"
      }
    ]
  },
